# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Environment / secrets
.env
# A filled-in OpenShift Secret must never be committed (template is tracked).
deploy/openshift/*secret*.yaml
!deploy/openshift/secret.example.yaml

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated / binary office docs (deliverables, not source)
*.xlsx
*.docx
*.doc
out/*
# ...except the hand-filled case-study events template, which is source.
!out/events.template.csv

# Internal LF / revenue extracts are never source. They belong under out/ (above),
# and this is the backstop for one landing anywhere else. Already-tracked CSVs in
# analysis/output/ are unaffected — .gitignore does not apply to tracked files.
*.csv
!out/events.template.csv

# Media / archives (demos, not source — keep them out of the repo)
*.mp4
*.mov
*.webm
*.avi
*.mkv
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# OS
.DS_Store
