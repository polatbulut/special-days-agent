# Copy to .env and fill in what you need. Holidays work with no keys at all.

# Ticketmaster Discovery (concerts/sports/arts): https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# API-Football / API-Sports (fixtures): https://www.api-football.com/
FOOTBALL_API_KEY=

# EventsEye trade-fair scrape: set to 1 to enable (off by default).
EVENTSEYE_ENABLED=

# ConferenceIndex business-seminar scrape: set to 1 to enable (off by default).
SEMINARS_ENABLED=

# LLM impact scorer (optional; default is the offline heuristic).
# openai:
OPENAI_API_KEY=
# vllm (OpenAI-compatible server):
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=
# azure:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_MAX_COMPLETION_TOKENS=
AZURE_OPENAI_TIMEOUT_SECONDS=
# Optional on external/corporate workbenches with a custom proxy CA chain.
# Point these at the PEM bundle / CA directory before using --impact-scorer azure.
# SSL_CERT_FILE=/path/to/corporate-ca.pem
# SSL_CERT_DIR=/path/to/certs

# OBS output (--obs). Write-scoped service account. Never commit real values.
OBS_ENDPOINT=bigdata-dev.obs.thy.com
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
# Optional OBS target override (else --obs-location, else the default):
# SPECIAL_DAYS_LOCATION=obs://lakehouse-dev/special_events
